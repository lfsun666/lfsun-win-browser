      "displayName": "刷新",
      "visible": true,
      "order": 2
    },
    {
      "id": "newTab",
      "displayName": "新建标签",
      "visible": true,
      "order": 3
    },
    {
      "id": "closeTab",
      "displayName": "关闭标签",
      "visible": true,
      "order": 4
    },
    {
