{
  "startPage": "about:blank",
  "maxLiveTabs": 3,
  "suspendAfterMinutes": 3,
  "pluginsDirectoryName": "plugins",
  "enforcePluginPermissions": true,
  "allowedPluginPermissions": [
    "content:dom_read",
    "content:dom_write",
    "content:inject",
    "net:fetch"
  ],
  "isGeneralAutofillEnabled": true,
  "isPasswordAutosaveEnabled": true,
  "isCredentialAutofillEnabled": true,
  "defaultSearchEngineName": "Bing",
  "defaultSearchEngineUrlTemplate": "https://www.bing.com/search?q={query}",
  "uiTheme": "Light",
  "uiAccent": "Blue",
  "uiAccentStrength": "Standard",
  "uiFont": "YaHei",
  "zenMode": false,
  "uiDensity": "Normal",
  "showBookmarksBar": true,
  "downloadDirectory": "E:\\Downloads\\",
  "bookmarksFileName": "bookmarks.json",
  "credentialsFileName": "credentials.json",
  "historyFileName": "history.json",
  "shortcutAddBookmarkEnabled": true,
  "shortcutAddBookmark": "Ctrl+D",
  "shortcutNewTabEnabled": true,
  "shortcutNewTab": "Ctrl+T",
  "shortcutCloseTabEnabled": true,
  "shortcutCloseTab": "Ctrl+W",
  "shortcutFocusAddressEnabled": true,
  "shortcutFocusAddress": "Ctrl+L",
  "shortcutRefreshEnabled": true,
  "shortcutRefresh": "F5",
  "shortcutDevToolsEnabled": true,
  "shortcutDevTools": "F12",
  "shortcutToggleBookmarksBarEnabled": true,
  "shortcutToggleBookmarksBar": "Ctrl+B",
  "shortcutRestoreClosedTabEnabled": true,
  "shortcutRestoreClosedTab": "Ctrl+Shift+T",
  "shortcutOpenHistoryEnabled": true,
  "shortcutOpenHistory": "Ctrl+H",
  "toolbarButtons": [
    {
      "id": "back",
      "displayName": "后退",
      "visible": true,
      "order": 0
    },
    {
